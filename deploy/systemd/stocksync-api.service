# StockSync Analytics — the API process.
#
#   sudo cp deploy/systemd/stocksync-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemd-analyze verify /etc/systemd/system/stocksync-api.service
#   sudo systemctl enable --now stocksync-api
#   systemctl status stocksync-api
#
# If it will not start, the reason is in `journalctl -u stocksync-api -n 50`.
# app.config refuses to construct Settings when STOCKSYNC_ENV=production and
# JWT_SECRET / ENCRYPTION_KEY / COOKIE_SECURE are not set, and create_app() runs
# at import — so a missing one is a hard exit at startup, not a degraded server.

[Unit]
Description=StockSync Analytics API
After=network-online.target
Wants=network-online.target

# These belong in [Unit], not [Service]. systemd moved the start rate limiter
# to the unit in v229; left under [Service] they are parsed as unknown keys,
# logged as a warning and ignored — so a permanently misconfigured server
# restarts forever instead of stopping after three attempts, and the real error
# scrolls out of the journal.
#
# A config error is permanent: give up after 3 attempts in a minute so
# `systemctl status` shows the failure that matters.
StartLimitBurst=3
StartLimitIntervalSec=60

[Service]
Type=exec
# NOTE: this user must own the project directory and be able to write data/ and
# storage/. On a host where the checkout lives under /home/ubuntu that is
# usually `ubuntu`, not a separate system account — check with `ls -ld` before
# enabling, because a mismatch fails at startup with a permission error that
# reads like a bug in the application.
User=stocksync
Group=stocksync

# pydantic-settings reads env_file=("../.env", ".env") relative to the working
# directory, so this picks up /home/ubuntu/StockSync-Analytics/.env — the
# repo-root .env, exactly as it works in development. Nothing else needs to
# know where secrets live.
WorkingDirectory=/home/ubuntu/StockSync-Analytics/backend

# --proxy-headers is not optional behind nginx. auth.py reads
# request.client.host for both login throttling and the recorded session IP;
# without it every request appears to come from 127.0.0.1, so one attacker's
# failed logins trip the per-address lockout for every user at once.
# --forwarded-allow-ips restricts that trust to the local proxy, so a client
# cannot forge X-Forwarded-For and evade its own throttle.
ExecStart=/home/ubuntu/StockSync-Analytics/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --proxy-headers \
    --forwarded-allow-ips 127.0.0.1

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

# `ProtectHome=true` would make this unit unstartable now that the project
# lives under /home. It replaces /home with an empty directory, so the venv in
# ExecStart above simply would not exist and the service would fail 203/EXEC
# before running a line of Python.
#
# `tmpfs` keeps the intent — every other user's home stays hidden from this
# process — and BindPaths= puts back the one directory it actually needs.
ProtectHome=tmpfs
BindPaths=/home/ubuntu/StockSync-Analytics

# The SQLite file, its WAL sidecars, generated exports and snapshots are the
# only paths that need to be writable.
#
# All at the repo root regardless of where a command is run from: config.py
# resolves a relative STOCKSYNC_DATABASE_URL, EXPORT_DIR or BACKUP_DIR against
# the repo root, not the working directory. That is what stops `alembic` run
# from one folder and the server started from another using two different
# database files.
ReadWritePaths=/home/ubuntu/StockSync-Analytics/data /home/ubuntu/StockSync-Analytics/storage

[Install]
WantedBy=multi-user.target
