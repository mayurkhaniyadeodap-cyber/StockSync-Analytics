root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{md,markdown}]
# Trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.ps1]
# Windows PowerShell 5.1 reads .ps1 as ANSI without a BOM and needs CRLF.
end_of_line = crlf
charset = utf-8-bom
indent_size = 4

[Makefile]
indent_style = tab
