# StockSync Analytics — environment template.
# Copy to .env and fill in. Never commit .env.
#
#   PowerShell:  Copy-Item .env.example .env

# --- app ---
STOCKSYNC_ENV=development               # development | test | production
STOCKSYNC_DEBUG=true
STOCKSYNC_API_PREFIX=/api

# --- database ---
# SQLite by default. The path is relative to the repo root; the directory is
# created on first run. Leave this unset to use the same default.
STOCKSYNC_DATABASE_URL=sqlite+pysqlite:///./data/stocksync.db

# How long a write waits for another write to finish before failing with
# "database is locked". SQLite allows one writer at a time, so a Shopify sync
# and a user saving a setting can contend. Long enough to cover the one write
# that cannot be made short — swapping in a rebuilt rollup, ~11s at half a
# million rows — so a token renewal arriving mid-swap waits rather than fails.
STOCKSYNC_DB_BUSY_TIMEOUT_SECONDS=30

# Connection pooling. Ignored by SQLite (not a client/server database); these
# take effect only if the URL above is pointed at a server dialect.
STOCKSYNC_DB_POOL_SIZE=5
STOCKSYNC_DB_MAX_OVERFLOW=10

# To move to PostgreSQL later, install the driver (`pip install "psycopg[binary]"`)
# and set the URL — no application code changes:
# STOCKSYNC_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/stocksync

# --- web ---
# Origins allowed to call the API with credentials. Vite dev server by default.
STOCKSYNC_CORS_ORIGINS=http://localhost:5173

# --- logging ---
STOCKSYNC_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
STOCKSYNC_LOG_FORMAT=console            # console | json

# --- auth ---
# Signs the access token. REQUIRED in production (the app refuses to start
# without at least 32 characters); development falls back to a random
# per-process value, so restarting the dev server signs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STOCKSYNC_JWT_SECRET=

STOCKSYNC_ACCESS_TOKEN_MINUTES=15
STOCKSYNC_REFRESH_TOKEN_DAYS=30
# Lifetime when "Keep me signed in" is unchecked.
STOCKSYNC_REFRESH_TOKEN_SESSION_HOURS=12

# Set true in production. Requires HTTPS — with it on, browsers refuse to send
# the auth cookies over plain http and nobody can sign in.
#
# A production server REFUSES TO START without it. If TLS genuinely terminates
# elsewhere and the remaining hop is trusted, say so explicitly with
# STOCKSYNC_ALLOW_INSECURE_COOKIES=true; leaving it unset is treated as an
# oversight rather than a decision, because that is what it usually is.
STOCKSYNC_COOKIE_SECURE=false
# STOCKSYNC_ALLOW_INSECURE_COOKIES=false

# --- login throttling ---
# Failed sign-ins are counted per account and per client address; either
# crossing the threshold refuses the next attempt for the lockout period.
# A successful sign-in clears the count.
STOCKSYNC_LOGIN_MAX_ATTEMPTS=8
STOCKSYNC_LOGIN_ATTEMPT_WINDOW_SECONDS=300
STOCKSYNC_LOGIN_LOCKOUT_SECONDS=900

# --- security headers ---
# Strict-Transport-Security max-age, sent only when STOCKSYNC_COOKIE_SECURE is
# on: pinning a browser to HTTPS from a server that answers on HTTP locks
# people out until it expires. 0 disables the header.
STOCKSYNC_HSTS_MAX_AGE_SECONDS=63072000
# STOCKSYNC_COOKIE_DOMAIN=

# --- shopify (M2) ---
# Encrypts the Shopify Admin API token at rest. Same contract as JWT_SECRET:
# REQUIRED in production (the app refuses to start without it); development
# falls back to a random per-process key, which means restarting the dev server
# makes an already-saved token unreadable and the store must be reconnected.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STOCKSYNC_ENCRYPTION_KEY=

# --- shopify credentials, DEVELOPMENT ONLY ---
# These four use Shopify's own variable names, unprefixed. There is exactly one
# spelling for each; STOCKSYNC_SHOPIFY_* is not read.
#
# Setting the store URL and the token together connects a store without using
# the Connect form, so a development store survives `reset-db` without being
# re-entered. Both must be set for either to be used.
#
#   * A store connected through the app ALWAYS wins over these.
#   * IGNORED ENTIRELY when STOCKSYNC_ENV=production — a token in a file is
#     plaintext on disk, which is strictly worse than the encrypted-at-rest
#     storage the Connect flow uses. Start-up logs a warning if it finds one.
#   * NEVER PUT A REAL TOKEN IN THIS FILE. It is the committed template.
#     Real values belong in .env, which is gitignored.
#
# The store URL accepts any of: mystore.myshopify.com, the full
# https://admin.shopify.com/store/mystore URL, or the bare store name.
# The token needs read_products and read_orders.
SHOPIFY_STORE_URL=
SHOPIFY_ADMIN_API_TOKEN=

# Shopify versions its Admin API by date. Pinned so Shopify promoting a new
# stable version can't change behaviour under us.
SHOPIFY_API_VERSION=2026-07
SHOPIFY_TIMEOUT_SECONDS=15

# --- inventory import (M2) ---
# Design doc §8.2 states 25MB. Raise it if real sheets are bigger; the whole
# file is read into memory to parse, so this is also the per-request ceiling.
STOCKSYNC_MAX_UPLOAD_MB=25

# --- Google Sheet import ---
# How long to wait for Google to answer the CSV export. Spent inside a request
# the user is watching, so shorter than the Shopify timeout. The same
# MAX_UPLOAD_MB above caps the download.
STOCKSYNC_IMPORT_URL_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Added in later milestones. Listed here so the full surface is visible, but
# nothing reads them yet.
#
# M3  STOCKSYNC_GOOGLE_CLIENT_ID=
# M3  STOCKSYNC_GOOGLE_CLIENT_SECRET=
# M6  STOCKSYNC_EXPORT_DIR=./storage/exports
# ---------------------------------------------------------------------------
